@using Warehouse.Client.Resources
@inject IStringLocalizer<SharedResource> Loc

<div class="input-group mb-3">
    <InputText class="form-control" placeholder="@Placeholder" @bind-Value="searchByName"></InputText>
    <button class="btn btn-success" type="button" @onclick="() => PassSearchName.InvokeAsync(searchByName)">@Loc["Search"]</button>
</div>

@code {
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public EventCallback<string> PassSearchName { get; set; }
    private string? searchByName { get; set; }
}
