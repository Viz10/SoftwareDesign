<div class="mt-3">
    <button class="btn btn-sm btn-primary"
            @onclick='() => eventCallback.InvokeAsync("JSON")'>
        Export As JSON
    </button>
    <button class="btn btn-sm btn-primary"
            @onclick='() => eventCallback.InvokeAsync("CSV")'>
        Export As CSV
    </button>
    <button class="btn btn-sm btn-primary"
            @onclick='() => eventCallback.InvokeAsync("XML")'>
        Export As XML
    </button>
</div>
@code {
    [Parameter] public EventCallback<string> eventCallback { get; set; }
}
