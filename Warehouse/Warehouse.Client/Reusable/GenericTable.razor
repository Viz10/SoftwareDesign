@using Microsoft.AspNetCore.Components.Authorization
@using Warehouse.Client.Models
@inject NavigationManager Nav

@using Warehouse.Client.Resources
@inject IStringLocalizer<SharedResource> Loc

@if (Model == null || CellNameValuePair == null)
{
    <p><em>@Loc["Loading"]...</em></p>
}
else
{
    <h3>@Model.TableTitle</h3>

    <div class="mt-4 mb-4">
        <table class="table table-striped table-lg">
            <thead>
                <tr>
                    @foreach (var col in Model.ColumnNames)
                    {
                        <th>@col</th>
                    }
                </tr>
            </thead>
            <tbody>
                <GenericTableCells Model="@Model" CellNameValuePair="@CellNameValuePair"></GenericTableCells>
            </tbody>
        </table>
    </div>

    <AuthorizeView Roles="Admin,Seller">
        <div class="mt-3">
            <button class="btn btn-sm btn-primary"
                    @onclick='() => Nav.NavigateTo(Model.AddPagePath)'>
                @Loc["Add"]
            </button>
        </div>
    </AuthorizeView>

    
}
@code {
    [Parameter] public GenericTablePlugIns Model { get; set; } = null!;
    [Parameter] public IEnumerable<Dictionary<string, object>> CellNameValuePair { get; set; } = null!;
}
