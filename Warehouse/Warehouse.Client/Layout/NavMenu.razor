@using Microsoft.AspNetCore.Components.Authorization
@using Warehouse.Client.Auth

@using Warehouse.Client.Resources
@inject IStringLocalizer<SharedResource> Loc

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Warehouse @System.Globalization.CultureInfo.CurrentUICulture.Name</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> @Loc["Home"]
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <span class="nav-link text-light">
                        @context.User.FindFirst(c => c.Type.Contains("email"))?.Value
                    </span>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Items">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> @Loc["Items"]
                    </NavLink>
                </div>

                <AuthorizeView Roles="Admin" Context="adminContext">
                   
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="Register">
                            <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> @Loc["Register"]
                        </NavLink>
                    </div>
                    
                </AuthorizeView>
                
                <AuthorizeView Roles="Admin,Seller" Context="viewEmails">
                   
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="View-Emails">
                            <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> @Loc["Emails"]
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="chat">
                            <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> @Loc["Chat"]
                        </NavLink>
                    </div>
                   
                </AuthorizeView>

                <div class="nav-item px-3">
                    <button class="nav-link btn btn-link" @onclick="HandleLogout">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> @Loc["Logout"]
                    </button>
                </div>

            </Authorized>

            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Login">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> @Loc["Login"]
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Register">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> @Loc["Register"]
                    </NavLink>
                </div>
            </NotAuthorized>

        </AuthorizeView>

    </nav>
</div>


@inject JwtAuthStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

@code {
    private async Task HandleLogout()
    {
        await AuthStateProvider.NotifyLogout();
        NavigationManager.NavigateTo("login");
    }
}