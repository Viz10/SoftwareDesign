@page "/items"

@attribute [Authorize]

@using Warehouse.Client.Auth
@using Warehouse.Client.Reusable
@using Warehouse.Shared.DTOs.ItemDTO
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Authorization
@using Warehouse.Shared.Common

@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject JwtAuthStateProvider AuthProvider
@inject IJSRuntime JS

<PageTitle>Warehouse Items</PageTitle>

<Alert error="@alertMsg"></Alert>
<DictionaryErrors Errors="fieldErrors"/>

<SearchBar PassSearchName="HandleSearchByName" Placeholder="Search by name"></SearchBar>

<div class="form-group">
    <label for="OrderBy">Order By</label>
    <InputSelect id="OrderBy" @bind-Value="orderBy" class="form-control">
        @foreach (var sel in Selectorder)
        {
            <option value="@sel">@sel</option>
        }
    </InputSelect>
</div>
<br />

<GenericTable Model="@Model" CellNameValuePair="@CellNameValuePair"></GenericTable>

<ExportButtons eventCallback="Export"></ExportButtons>

@code {
    private Dictionary<string, List<string>> fieldErrors = new();
    private string? alertMsg;

    public string? searchByName { get; set; }
    public string? orderBy { get; set; }

    public IEnumerable<Dictionary<string, object>> CellNameValuePair { get; set; } = null!;
    public GenericTablePlugIns Model { get; set; } = null!;

    private List<string> Selectorder = default!;
    private List<ItemGetResponse> ExportValues = new List<ItemGetResponse>();
    private HttpClient httpClient { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        Selectorder = new List<string> {"ascending", "descending"};
        httpClient = HttpFactory.CreateClient("InventoryService");
        InitTablePlugins();
        await InitCellNameValuePairs();   
    }

    private async Task InitCellNameValuePairs()
    {
        alertMsg = null;
        fieldErrors = new();

        try
        {
            var response = await httpClient.GetAsync($"api/item?name={searchByName}&sortBy={orderBy}");
            var result = await response.Content.ReadFromJsonAsync<Result<List<ItemGetResponse>>>();

            if (result is null)
            {
                alertMsg = "Unexpected error, please try again.";
                return;
            }

            if (!result.IsSuccessful)
            {
                fieldErrors = result.Errors!;
                return;
            }

            if (result.Value!.Count > 0)
            {
                ExportValues = result.Value!;
                CellNameValuePair = result.Value!.Select(dto => new Dictionary<string, object>
                {
                    ["Id"] = dto.Id,
                    ["Name"] = dto.Name,
                    ["Description"] = dto.Description ?? "",
                    ["Base Price Per Item"] = dto.ReferencePricePerItem ?? 0,
                    ["Quantity"] = dto.Quantity
                });
            }
            else
            {
                CellNameValuePair = new List<Dictionary<string, object>>();
                alertMsg = "No items!";
            }
        }
        catch(Exception ex)
        {
            Console.WriteLine(ex.Message);
            alertMsg = $"{ex.Message} {ex.InnerException?.Message}";
        }
    }
    private void InitTablePlugins()
    {
        Model = new GenericTablePlugIns()
        {
            TableTitle = "Items Table",
            ColumnNames = new List<string> { "Id", "Name", "Description", "Base Price Per Item", "Quantity" },
            EditBasePagePath = "/items/edit",
            AddPagePath = "/items/add",
            OnDeleteCallback = EventCallback.Factory.Create<int>(this,HandleDelete),
            ExtraActions = new List<(string ButtonLabel, EventCallback<int> Action)> { ("See Products", EventCallback.Factory.Create<int>(this, (id) => Nav.NavigateTo($"/stockUnits/{id}"))) }
        };
    }
    private async Task Export(string format)
    {
        alertMsg = null;
        try
        {
            var response = await httpClient.GetAsync($"api/item/export-items?strategyName={format}");

            response.EnsureSuccessStatusCode();

            var fileBytes = await response.Content.ReadAsByteArrayAsync();
            var base64String = Convert.ToBase64String(fileBytes);

            await JS.InvokeVoidAsync("downloadFile", $"items.{format}", base64String);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"{ex.Message} {ex.InnerException?.Message}");
            alertMsg = $"{ex.Message} {ex.InnerException?.Message}";
        }
    }
    
    public async Task HandleDelete(int id) {

        alertMsg = null;
        fieldErrors = new();

        try
        {
            var response = await httpClient.DeleteAsync($"api/item/delete/{id}");
            var result = await response.Content.ReadFromJsonAsync<Result>();

            if (result is null)
            {
                alertMsg = "Unexpected error, please try again.";
                return;
            }

            if (!result.IsSuccessful)
            {
                fieldErrors = result.Errors!;
                return;
            }
            /// every time the reference CellNameValuePair changes , it propagates through components [Parameter] to rerender where its used
            await InitCellNameValuePairs(); 
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            alertMsg = $"{ex.Message} {ex.InnerException?.Message}";
        }
    }
    public async Task HandleSearchByName(string? name)
    {
        searchByName = name;
        await InitCellNameValuePairs();
    }
}