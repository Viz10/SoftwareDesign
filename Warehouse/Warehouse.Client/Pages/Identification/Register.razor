@page "/register"

@using Warehouse.Client.Reusable
@using Warehouse.Shared.DTOs.AccountDTO
@using Warehouse.Shared.Enums
@using Warehouse.Shared.Common
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms

@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav

@using Warehouse.Client.Resources
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["Register"]</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">

            <Alert error="@alertMsg"></Alert>
            <DictionaryErrors Errors="fieldErrors" />

            <EditForm Model="DTO" OnSubmit="HandleRegister">
                <div class="form-group mb-3">
                    <label>Email</label>
                    <InputText class="form-control" type="email" @bind-Value="DTO.Email" />
                </div>

                <div class="form-group mb-3">
                    <label>Password</label>
                    <InputText class="form-control" type="password" @bind-Value="DTO.Password" />
                </div>

                <div class="form-group mb-3">
                    <label>Confirm Password</label>
                    <InputText class="form-control" type="password" @bind-Value="DTO.ConfirmPassword" />
                </div>

                <AuthorizeView Roles="Admin" Context="authContext"> @*only admin can select role*@
                    <div class="form-group mb-3">
                        <label>Account Type</label>
                        <InputSelect @bind-Value="DTO.AccountType" class="form-control">
                            @foreach (var type in Enum.GetValues<AccountType>())
                            {
                                <option value="@type">@type</option>
                            }
                        </InputSelect>
                    </div>
                </AuthorizeView>

                <hr />

                @if (isLoading)
                {
                    <div class="text-center">
                        <div class="spinner-border text-primary" role="status"></div>
                    </div>
                }
                else
                {
                    <button type="submit" class="btn btn-primary w-100 mb-2">@Loc["Register"]</button>
                    <button type="button" class="btn btn-outline-secondary w-100" @onclick='() => Nav.NavigateTo("/")'>@Loc["Cancel"]</button>
                }

            </EditForm>

        </div>
    </div>
</div>

@code {
    private RegisterRequest DTO = new();
    private Dictionary<string, List<string>> fieldErrors = new();

    private string? alertMsg;
    private bool isLoading = false;

    private HttpClient httpClient { get; set; } = null!;

    protected override void OnInitialized()
    {
        httpClient = HttpFactory.CreateClient("AccountService");
    }

    private async Task HandleRegister()
    {
        isLoading = true;
        alertMsg = null;
        fieldErrors = new();

        try
        {
            var response = await httpClient.PostAsJsonAsync("api/account/register", DTO);
            var result = await response.Content.ReadFromJsonAsync<Result>();

            if (result is null)
            {
                alertMsg = "Unexpected error, please try again.";
                return;
            }

            if (!result.IsSuccessful)
            {
                fieldErrors = result.Errors!;
                return;
            }

            alertMsg = "Succesfully registered";
            DTO = new(); /// reset

        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            alertMsg = "System error";
        }
        finally
        {
            isLoading = false;
        }
    }
}