@page "/view-emails"
@using Warehouse.Client.Reusable
@using Warehouse.Shared.Common
@using System.Net.Http.Json
@inject IHttpClientFactory HttpFactory

<PageTitle>Warehouse Account Emails</PageTitle>

<div class="container mt-4">
    <h3>Warehouse Account Emails</h3>
    
    <Alert error="@alertMsg"></Alert>
    <DictionaryErrors Errors="fieldErrors" />

    @if (isLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (emailList != null)
    {
        <div class="overflow-auto border rounded p-3 bg-light" style="max-height: 500px;">
            <div class="list-group">
                @if (emailList.Any())
                {
                    @foreach (var email in emailList)
                    {
                        <div class="list-group-item list-group-item-action mb-2 shadow-sm rounded">
                            <p class="mb-0" style="white-space: pre-wrap;">@email</p>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted text-center">No emails found for this account.</p>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<string> emailList = new();
    private Dictionary<string, List<string>> fieldErrors = new();

    private string? alertMsg;
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadEmails();
    }

    private async Task LoadEmails()
    {
        isLoading = true;
        alertMsg = null;
        fieldErrors = new();

        try
        {
            var client = HttpFactory.CreateClient("AccountService");
            var response = await client.GetAsync("api/account/emails");
            var result = await response.Content.ReadFromJsonAsync<Result<List<string>>>();

            if (result is null)
            {
                alertMsg = "Unexpected error, please try again.";
                return;
            }

            if (!result.IsSuccessful)
            {
                fieldErrors = result.Errors!;
                return;
            }

            emailList = result.Value;
        }
        catch (Exception ex)
        {
            alertMsg = $"Something went wrong: {ex.Message} {ex.InnerException?.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}