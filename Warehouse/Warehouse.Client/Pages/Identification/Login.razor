@page "/login"

@using Warehouse.Client.Auth
@using Warehouse.Client.Reusable
@using Warehouse.Shared.DTOs.AccountDTO
@using Warehouse.Shared.Common
@using Microsoft.AspNetCore.Components.Forms

@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject JwtAuthStateProvider AuthProvider

<PageTitle>Login</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">

            <Alert error="@alertMsg"></Alert>
            <DictionaryErrors Errors="fieldErrors"/>

            <EditForm Model="DTO" OnSubmit="HandleLogin">
                <div class="form-group mb-3">
                    <label for="Email">Email</label>
                    <InputText id="Email" 
                               type="email" 
                               class="form-control" 
                               @bind-Value="DTO.Email" />
                </div>

                <div class="form-group mb-3">
                    <label for="Password">Password</label>
                    <InputText id="Password" 
                               type="password" 
                               class="form-control" 
                               @bind-Value="DTO.Password" />
                </div>

                <hr />

                @if (isLoading)
                {
                    <div class="text-center">
                        <div class="spinner-border text-primary" role="status"></div>
                    </div>
                }
                else
                {
                    <button type="submit" class="btn btn-primary w-100 mb-2">Login</button>
                    <button type="button" class="btn btn-outline-secondary w-100" @onclick='() => Nav.NavigateTo("/")'>Go Back</button>
                }
            </EditForm>

        </div>
    </div>
</div>

@code {
    private LoginRequest DTO = new();
    private Dictionary<string, List<string>> fieldErrors = new();
   
    private string? alertMsg;
    private bool isLoading = false;

    private HttpClient httpClient { get; set; } = null!;

    protected override void OnInitialized()
    {
        httpClient = HttpFactory.CreateClient("AccountService");
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        alertMsg = null;
        fieldErrors = new();

        try
        {
            var response = await httpClient.PostAsJsonAsync("api/account/login", DTO);
            var result = await response.Content.ReadFromJsonAsync<Result<MessageResponse>>();

            if (result is null)
            {
                alertMsg = "Unexpected error, please try again.";
                return;
            }

            if (!result.IsSuccessful)
            {
                fieldErrors = result.Errors!;
                return;
            }

            await AuthProvider.NotifyLogin(result.Value!.Message); /// save jwt in local storage , notify UI 
            Nav.NavigateTo("/items"); /// redirect
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            alertMsg = "Something went wrong";
        }
        finally
        {
            isLoading = false;
        }
    }
}