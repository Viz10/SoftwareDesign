@page "/login"
@using Warehouse.Client.Auth
@using Warehouse.Client.Reusable
@using Warehouse.Shared.DTOs.AccountDTO
@using Warehouse.Shared.Common
@using Microsoft.AspNetCore.Components.Forms

@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject JwtAuthStateProvider AuthProvider

<PageTitle>Login</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <h3 class="mb-4 text-center">Login</h3>

            <Alert error="@alertMsg"></Alert>
            <DictionaryErrors Errors="fieldErrors"/>

            <EditForm Model="command" OnSubmit="HandleLogin">
                <div class="form-group mb-3">
                    <label for="Email">Email</label>
                    <InputText id="Email" 
                               type="email" 
                               class="form-control" 
                               @bind-Value="command.Email" />
                </div>

                <div class="form-group mb-3">
                    <label for="Password">Password</label>
                    <InputText id="Password" 
                               type="password" 
                               class="form-control" 
                               @bind-Value="command.Password" />
                </div>

                <hr />

                <button type="submit" class="btn btn-primary w-100" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" />
                    }
                    Login
                </button>

                <button type="button" class="btn btn-outline-secondary w-100 mt-2"
                        @onclick='() => Nav.NavigateTo("/")'>
                    Go Back
                </button>
            </EditForm>

        </div>
    </div>
</div>

@code {
    private LoginRequest command = new();
    private Dictionary<string, List<string>> fieldErrors = new();
   
    private string? alertMsg;
    private bool isLoading = false;

    private async Task HandleLogin()
    {
        isLoading = true;
        alertMsg = null;
        fieldErrors = new();

        try
        {
            var client = HttpFactory.CreateClient("AccountService");
            var response = await client.PostAsJsonAsync("api/account/login", command);
            var result = await response.Content.ReadFromJsonAsync<Result<Message>>();

            if (result is null)
            {
                alertMsg = "Unexpected error, please try again.";
                return;
            }

            if (!result.IsSuccessful)
            {
                fieldErrors = result.Errors!;
                return;
            }

            await AuthProvider.NotifyLogin(result.Value!.message);
            Nav.NavigateTo("/");
        }
        catch (Exception ex)
        {
            alertMsg = $"Something went wrong: {ex.Message} {ex.InnerException?.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}