
<div class="input-group mb-3">
    <InputText class="form-control" placeholder="Search by name" @bind-Value="searchByName"></InputText>
    <button class="btn btn-success" type="button" @onclick="() => PassSearchName.InvokeAsync(searchByName)">Search</button>
</div>

@code {
    [Parameter] public EventCallback<string> PassSearchName { get; set; }
    private string? searchByName { get; set; }
}
