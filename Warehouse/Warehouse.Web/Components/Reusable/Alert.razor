
@if (error != null)
{
    <div class="alert alert-danger alert-dismissible">
        @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" @onclick="() => error=null"></button>
    </div>
}
@if (succes != null)
{
    <div class="alert alert-success alert-dismissible">
        @succes
        <button type="button" class="btn-close" data-bs-dismiss="alert" @onclick="() => succes=null"></button>
    </div>
}

@code {
    [Parameter] public string? error { get; set; }
    [Parameter] public string? succes { get; set; }
}
