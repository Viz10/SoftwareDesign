@page "/Items"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Warehouse.Data.Data.DTOs.ItemDTOs
@using Warehouse.Services.Services.Exports
@using Warehouse.Web.Components.Reusable
@using Warehouse.Services
@using Warehouse.Web.Models

@inject ItemService itemservice
@inject NavigationManager Nav

<PageTitle>Warehouse Items</PageTitle>

<Alert error="@error"></Alert>

<SearchBar PassSearchName="HandleSearchByName" Placeholder="Search by name"></SearchBar>

<div class="form-group">
    <label for="OrderBy">Order By</label>
    <InputSelect id="OrderBy" @bind-Value="orderBy" class="form-control">
        @foreach (var sel in Selectorder)
        {
            <option value="@sel">@sel</option>
        }
    </InputSelect>
</div>
<br />

<GenericTable Model="@Model" CellNameValuePair="@CellNameValuePair"></GenericTable>

<ExportButtons eventCallback="Export"></ExportButtons>

@code {

    private string? error;
    public string? searchByName { get; set; }
    public string? orderBy { get; set; }
  
    public IEnumerable<Dictionary<string, object>> CellNameValuePair { get; set; } = default!;
    public GenericTablePlugIns Model { get; set; } = default!;
    private List<string> Selectorder = default!;
    public List<ItemGetDTO> ExportValues = new List<ItemGetDTO>();

    protected override async Task OnInitializedAsync()
    {
        Selectorder = new List<string> {"ascending", "descending" };
        await InitCellNameValuePairs();
        InitTablePlugins();
    }

    public async Task InitCellNameValuePairs()
    {
        var Result = await itemservice.searchItemTypeByPartialName(searchByName, orderBy);

        if (!Result.IsSuccessful)
        {
            error = Result.ErrorMsg;
            CellNameValuePair = new List<Dictionary<string, object>>();
            return;
        }

        ExportValues = Result.Value;
        CellNameValuePair = Result.Value.Select(dto => new Dictionary<string, object>
        {
            ["Id"] = dto.Id,
            ["Name"] = dto.Name,
            ["Description"] = dto.Description ?? "",
            ["Base Price Per Item"] = dto.ReferencePricePerItem ?? 0,
            ["Quantity"] = dto.Quantity
        });

    }
    public void InitTablePlugins()
    {
        Model = new GenericTablePlugIns()
        {
            TableTitle = "Items Table",
            ColumnNames = new List<string> { "Id", "Name", "Description", "Base Price Per Item", "Quantity" },
            EditBasePagePath = "/Items/Edit",
            AddPagePath = "/Items/Add",
            OnDeleteCallback = EventCallback.Factory.Create<int>(this,HandleDelete),
            ExtraActions = new List<(string ButtonLabel, EventCallback<int> Action)> { ("See Products", EventCallback.Factory.Create<int>(this, (id) => Nav.NavigateTo($"/StockUnits/{id}"))) }
        };
    }

    /// every time the reference CellNameValuePair changes , it propagates through components to rerender where its used
    public async Task HandleDelete(int id) {

        error = null;

        var Result = await itemservice.delete(id);

        if (!Result.IsSuccessful)
        {
            error = Result.ErrorMsg;
            return;
        }

        await InitCellNameValuePairs(); /// refresh data reference
    }
    public async Task HandleSearchByName(string? name)
    {
        searchByName = name;
        await InitCellNameValuePairs();
    }
    
    [Inject] private Export ExportService { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    
    private async Task Export(string format)
    {
        var content = await ExportService.ExportData(ExportValues, format);
        await JS.InvokeVoidAsync("downloadFile", $"items.{format}", content);
    }
}
